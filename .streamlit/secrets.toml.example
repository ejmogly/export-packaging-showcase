# ==============================================================================
# Streamlit Secrets Template for Export Food Packaging Analytics Showcase
# ==============================================================================
# In local development: Rename this file to '.streamlit/secrets.toml' if connecting live.
# In Streamlit Cloud: Copy & paste into [App Settings] -> [Secrets].
#
# (Note: In Showcase Demo mode, if no GOOGLE_SHEET_URL is provided,
# the app seamlessly defaults to the pre-packaged verified dataset with 3,234 rows.)

# 1. Google Sheets Live Stream (Optional)
# GOOGLE_SHEET_URL = "https://docs.google.com/spreadsheets/d/your_sheet_id/export?format=csv&gid=your_gid"
# GOOGLE_SHEET_EDIT_URL = "https://docs.google.com/spreadsheets/d/your_sheet_id/edit"

# 2. Automated Monthly Email Reporting (Optional)
# MAIL_SERVER = "smtp.gmail.com"
# MAIL_PORT = 587
# MAIL_USERNAME = "your_email@gmail.com"
# MAIL_PASSWORD = "your_16_digit_app_password"
# MAIL_SENDER_NAME = "글로벌 패키징 센터"
# MAIL_RECIPIENTS = "executives@example.com,logistics@example.com"
